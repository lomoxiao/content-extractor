{
  "name": "@local/content-extractor",
  "version": "0.3.0",
  "description": "Shared source-typed content extractor (web / arxiv / youtube / x / pdf) for bookmark-curator and article-to-slides-automation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "content-extraction",
    "readability",
    "arxiv",
    "youtube",
    "scraping"
  ],
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "jsdom": "^29.1.1",
    "unpdf": "^1.6.2",
    "youtube-transcript": "^1.2.1"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.0.0",
    "playwright": "1.62.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
